---
import { type CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Giscus from '../components/Giscus.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'] & {
	showComments?: boolean;
};

const { title, description, pubDate, updatedDate, showComments = false } = Astro.props;
const isCommentGated = showComments;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		<div class="site-frame">
			<Header />
			<main class="page-main">
				<article class="post-page" data-comment-gated={isCommentGated ? 'true' : undefined}>
					<header class="post-header">
						<h1 class="pixel-title post-title">{title}</h1>
						<div class="post-meta">
							<time datetime={pubDate.toISOString()}><FormattedDate date={pubDate} /></time>
							{updatedDate && <><span aria-hidden="true">&middot;</span><span>Updated <FormattedDate date={updatedDate} /></span></>}
						</div>
					</header>

					{isCommentGated && (
						<section class="comment-gate" aria-labelledby="comment-gate-title">
							<h2 id="comment-gate-title">Comment to Unlock</h2>
							<p data-comment-gate-status>
								Sign in with GitHub, leave a comment below, then verify it to unlock this post.
							</p>
							<a class="comment-gate-button" href={`/api/comment-login?return_to=${encodeURIComponent(Astro.url.pathname)}`} data-github-login>
								Sign in with GitHub
							</a>
							<button class="comment-gate-button" type="button" data-verify-comment hidden>
								Verify my comment
							</button>
						</section>
					)}

					<div class="prose-article post-content">
						<slot />
					</div>

					<footer class="post-back">
						<a href="/blog/">&larr; Back to all posts</a>
					</footer>

					{showComments && <Giscus />}
				</article>
			</main>
			<Footer />
		</div>
		{isCommentGated && (
			<script is:inline>
				(() => {
					const post = document.querySelector('[data-comment-gated="true"]');
					if (!post) return;

					const status = post.querySelector('[data-comment-gate-status]');
					const login = post.querySelector('[data-github-login]');
					const verify = post.querySelector('[data-verify-comment]');
					let discussionNumber = null;

					const unlock = () => {
						post.dataset.unlocked = 'true';
					};

					const check = async () => {
						verify.disabled = true;
						status.textContent = 'Checking your GitHub comment…';
						try {
							const params = new URLSearchParams({ path: window.location.pathname });
							if (discussionNumber) params.set('discussion', discussionNumber);
							const response = await fetch(`/api/comment-status?${params}`, {
								credentials: 'same-origin',
								cache: 'no-store',
							});
							const result = await response.json();
							if (response.status === 401) {
								login.hidden = false;
								verify.hidden = true;
								status.textContent = 'Sign in with GitHub, leave a comment below, then verify it.';
							} else if (result.commented) {
								status.textContent = `Comment verified for @${result.login}.`;
								unlock();
							} else {
								login.hidden = true;
								verify.hidden = false;
								status.textContent =
									result.error || `No comment from @${result.login} was found yet. Comment below and try again.`;
							}
						} catch {
							status.textContent = 'Verification failed temporarily. Please try again.';
						} finally {
							verify.disabled = false;
						}
					};

					window.addEventListener('message', (event) => {
						if (event.origin !== 'https://giscus.app' || !event.data?.giscus) return;
						const discussion = event.data.giscus.discussion;
						if (discussion?.number) {
							discussionNumber = discussion.number;
							check();
						}
					});

					fetch('/api/comment-status', { credentials: 'same-origin', cache: 'no-store' })
						.then((response) => response.json().then((result) => ({ response, result })))
						.then(({ response, result }) => {
							if (response.status !== 401 && result.authenticated) {
								login.hidden = true;
								verify.hidden = false;
								status.textContent = `Signed in as @${result.login}. Loading the discussion…`;
							}
						})
						.catch(() => {});

					verify.addEventListener('click', check);
				})();
			</script>
		)}
	</body>
</html>
